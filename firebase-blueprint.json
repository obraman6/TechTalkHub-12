{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator membership document keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Non-PII account metadata and role assignment keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["student", "instructor", "admin"]
        },
        "publicProfileEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "username", "role", "publicProfileEnabled", "createdAt", "updatedAt"]
    },
    "PrivateUserInfo": {
      "title": "PrivateUserInfo",
      "description": "Isolated PII record for user contact details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "country": {
          "type": "string",
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Published TechTalkHub course catalog document.",
      "type": "object",
      "properties": {
        "courseCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "level": {
          "type": "string",
          "maxLength": 60
        },
        "durationHours": {
          "type": "number"
        },
        "passMark": {
          "type": "number"
        },
        "certificateType": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["published", "draft", "archived"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["courseCode", "title", "slug", "level", "durationHours", "passMark", "certificateType", "status", "updatedAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment and progress state for a course.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"]
        },
        "progressPercent": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "courseId", "status", "progressPercent", "createdAt", "updatedAt"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Issued TechTalkHub credential verifiable by unique Certificate ID.",
      "type": "object",
      "properties": {
        "certificateId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "recipientUid": {
          "type": "string",
          "maxLength": 128
        },
        "courseCode": {
          "type": "string",
          "maxLength": 40
        },
        "courseTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "level": {
          "type": "string",
          "maxLength": 60
        },
        "certificateType": {
          "type": "string",
          "maxLength": 80
        },
        "score": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["VALID", "REVOKED"]
        },
        "issueDate": {
          "type": "string",
          "maxLength": 64
        },
        "verificationUrl": {
          "type": "string",
          "maxLength": 300
        },
        "issuedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "directAdminIssue": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "certificateId",
        "recipientName",
        "courseCode",
        "courseTitle",
        "level",
        "certificateType",
        "score",
        "status",
        "issueDate",
        "verificationUrl",
        "issuedByUid",
        "directAdminIssue",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Public verification or support inquiry submitted via the Contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Verified administrator role membership documents."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Non-PII user profile metadata and role assignment."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivateUserInfo" },
      "description": "Owner-isolated PII details including email, phone, and city."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "TechTalkHub course catalog records."
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student course enrollment and progress tracking."
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Official issued certificates publicly verifiable by Certificate ID."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Platform support and credential verification inquiries."
    }
  }
}
