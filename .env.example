# GEMINI_API_KEY: Optional Gemini AI API key if needed by server-side features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where TechTalkHub is hosted (used for QR verification links).
APP_URL="MY_APP_URL"

# ADMIN_BOOT_PASSCODE: Optional server-side passcode for Admin authentication/override.
ADMIN_BOOT_PASSCODE=

# SESSION_SECRET: Secret key used to sign authentication session tokens.
SESSION_SECRET=
